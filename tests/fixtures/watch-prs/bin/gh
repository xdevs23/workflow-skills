#!/usr/bin/env python3
"""A stand-in for the GitHub CLI that answers from fixture JSON.

GH_STANDIN_FIXTURE is a JSON file with `loggedIn`, a boolean, and `api`, which maps a path without
its `per_page` and `page` parameters to a list of answers, one per call to the same page, the last
repeated once the list runs out. An answer is `{"json": [<page>...]}`, with an optional `date`, the
time of the response in seconds since the epoch, `{"fail": <stderr text>}`, `{"refuse": {...}}`
for a request refused over a rate limit, with `retryAfter` in seconds, `reset` and `date` in
seconds since the epoch, or `status` alone for a refusal that names no wait, or
`{"badCredentials": true}` for a token rejected by GitHub. Without a login, every call fails with
exit status 4 before it looks at the fixture answers, as gh does.

`gh api --include [-H 'If-None-Match: <etag>'] <path>` prints the status line, the headers and the
page named by the `page` parameter, with a Link header to the next page where there is one. When
the If-None-Match header matches the ETag of the page, it prints a 304 Not Modified and fails, as
gh does. GH_STANDIN_LOG names a file that receives every call as one JSON line.
"""

import hashlib
import json
import os
import sys
from email.utils import formatdate
from urllib.parse import parse_qsl, urlencode, urlsplit


def respond(status: str, headers: dict[str, str], body: str) -> None:
    """Prints a response the way `gh api --include` does: the status line, the headers, a blank line
    and the body."""
    sys.stdout.write(f"HTTP/2.0 {status}\r\n" + "".join(f"{name}: {value}\r\n" for name, value in headers.items())
                     + "\r\n" + body)


args = sys.argv[1:]
fixture = json.loads(open(os.environ["GH_STANDIN_FIXTURE"]).read())
log = os.environ["GH_STANDIN_LOG"]
calls = [json.loads(line) for line in open(log)] if os.path.exists(log) else []
with open(log, "a") as out:
    out.write(json.dumps(args) + "\n")

if not fixture["loggedIn"]:
    sys.stderr.write("To get started with GitHub CLI, please run:  gh auth login\n")
    sys.exit(4)

if args[:2] != ["api", "--include"] or len(args) not in (3, 5) or (len(args) == 5 and args[2] != "-H"):
    sys.exit(f"stand-in gh: unexpected call {args}")
path = args[-1]
url = urlsplit(path)
query = dict(parse_qsl(url.query))
page = int(query.pop("page", 1))
query.pop("per_page", None)
key = f"{url.path}?{urlencode(query)}" if query else url.path
answers = fixture["api"].get(key)
if not answers:
    sys.exit(f"stand-in gh: no answer for {key}")
answer = answers[min(sum(call[-1] == path for call in calls), len(answers) - 1)]
if "fail" in answer:
    sys.exit(answer["fail"])
if "refuse" in answer:
    refusal = answer["refuse"]
    headers = {"Date": formatdate(refusal.get("date"), usegmt=True)}
    if "retryAfter" in refusal:
        headers["Retry-After"] = str(refusal["retryAfter"])
    elif "reset" in refusal:
        headers |= {"X-RateLimit-Remaining": "0", "X-RateLimit-Reset": str(refusal["reset"])}
    respond(f"{refusal.get('status', 429)} Refused", headers,
            json.dumps({"message": "You have exceeded a secondary rate limit."}))
    sys.exit("gh: API rate limit exceeded (HTTP 429)")

if "badCredentials" in answer:
    respond("401 Unauthorized", {}, json.dumps({"message": "Bad credentials"}))
    sys.exit("gh: Bad credentials (HTTP 401)")

pages = answer["json"]
body = json.dumps(pages[page - 1])
headers = {"Date": formatdate(answer.get("date"), usegmt=True),
           "ETag": f'"{hashlib.sha256(body.encode()).hexdigest()}"'}
if page < len(pages):
    headers["Link"] = f'<{url.path}?{urlencode({**dict(parse_qsl(url.query)), "page": page + 1})}>; rel="next"'
modified = len(args) == 3 or args[3] != f"If-None-Match: {headers['ETag']}"
respond("200 OK" if modified else "304 Not Modified", headers, body if modified else "")
if not modified:
    sys.exit("gh: HTTP 304")
